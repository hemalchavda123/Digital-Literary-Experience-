// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String    @unique
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  profileImage      String?

  projects           Project[]
  labels             Label[]
  annotations        Annotation[]
  projectMemberships ProjectMember[]
  annotationComments AnnotationComment[]
  announcementReplies AnnouncementReply[]
  assignmentStatuses AssignmentStatus[]
  quizSubmissions    QuizSubmission[]

  @@index([email])
  @@index([username])
}

enum Role {
  VIEWER
  EDITOR
}

model Project {
  id                          String   @id @default(uuid())
  name                        String
  ownerId                     String
  defaultCanViewAnnotations   Boolean  @default(false)
  defaultCanAnnotate          Boolean  @default(true)
  defaultCanViewAdminAnnotations Boolean @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents   Document[]
  labels      Label[]
  members     ProjectMember[]
  invites     ProjectInvite[]
  announcements Announcement[]
  assignments   Assignment[]
  quizzes       Quiz[]

  @@index([ownerId])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  projectId String
  kind      String   @default("text")
  content   String   @default("")
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([projectId])
}

model Label {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  annotations Annotation[]

  @@index([projectId])
  @@index([userId])
}

model Annotation {
  id          String   @id @default(uuid())
  docId       String
  labelId     String
  content     String   @default("")
  startOffset Int
  endOffset   Int
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  comments AnnotationComment[]

  @@index([docId])
  @@index([userId])
}

model ProjectMember {
  id                         String   @id @default(uuid())
  projectId                  String
  userId                     String
  role                       Role     @default(VIEWER)
  canViewOthersAnnotations   Boolean  @default(false)
  canAnnotate                Boolean  @default(false)
  canViewAdminAnnotations    Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvite {
  id        String    @id @default(uuid())
  projectId String
  token     String    @unique @default(uuid())
  role      Role      @default(VIEWER)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([token])
}

model AnnotationComment {
  id           String     @id @default(uuid())
  annotationId String
  userId       String
  content      String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  annotation   Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([annotationId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(uuid())
  projectId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  replies   AnnouncementReply[]

  @@index([projectId])
}

model AnnouncementReply {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([userId])
}

model Assignment {
  id          String    @id @default(uuid())
  projectId   String
  documentId  String?
  title       String
  description String    @default("")
  dueDate     DateTime?
  totalMarks  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  statuses    AssignmentStatus[]

  @@index([projectId])
  @@index([documentId])
}

model AssignmentStatus {
  id           String     @id @default(uuid())
  assignmentId String
  userId       String
  status       String     @default("PENDING") // PENDING, SUBMITTED, COMPLETED
  grade        String?    
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  ONE_WORD
  SHORT_ANSWER
}

model Quiz {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String    @default("")
  status      QuizStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([projectId])
}

model QuizQuestion {
  id          String    @id @default(uuid())
  quizId      String
  type        QuestionType
  questionText String
  options     String?
  order       Int       @default(0)
  marks       Int       @default(1)
  correctAnswer String? 
  isPublished Boolean   @default(true)

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([quizId])
}

model QuizSubmission {
  id          String    @id @default(uuid())
  quizId      String
  userId      String
  submittedAt DateTime  @default(now())
  totalScore  Int?

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([quizId, userId])
  @@index([quizId])
  @@index([userId])
}

model QuizAnswer {
  id             String    @id @default(uuid())
  submissionId   String
  questionId     String
  answerText     String    @default("")
  isCorrect      Boolean?
  score          Int?

  submission     QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
}
